OBR_MCP_TOKEN=your-secret-token-here
# OBR_MCP_PORT=9876         # WSS relay port (extension connects here)
# OBR_MCP_HTTP_PORT=3000    # HTTP MCP server port (Claude Code connects here)
# OBR_MCP_ALLOWED_ORIGINS=https://abottchen.github.io,https://localhost:5173
#   Comma-separated origins allowed to open a relay WebSocket. Defaults to the
#   published extension plus the local vite dev server. Override only if you
#   host the extension elsewhere.
